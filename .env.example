NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
STUDENT_AUDIO_BUCKET=student-audio

# Server-only OpenAI settings for audio transcription. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Server-only secret used to pepper student PIN hashes (used by later plans).
# Generate a long random value (e.g. `openssl rand -hex 32`) and keep it out of
# the database and the browser bundle. Never prefix with NEXT_PUBLIC_.
PIN_HASH_PEPPER=replace-with-a-long-random-server-only-secret

# Server-only Azure AI Speech settings for pronunciation assessment (Phase 9).
# Never prefix with NEXT_PUBLIC_. Provision via Azure Portal -> Create resource ->
# Azure AI services -> Speech (free F0 tier).
AZURE_SPEECH_KEY=replace-with-azure-speech-key
# Must exactly match the region where the Speech resource was provisioned
# (Azure Portal -> Speech resource -> Keys and Endpoint -> Location/Region, e.g. eastus).
# A mismatched region produces auth/404-looking failures even with a correct key.
AZURE_SPEECH_REGION=replace-with-azure-speech-region
