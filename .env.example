NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
STUDENT_AUDIO_BUCKET=student-audio

# Server-only secret used to pepper student PIN hashes (used by later plans).
# Generate a long random value (e.g. `openssl rand -hex 32`) and keep it out of
# the database and the browser bundle. Never prefix with NEXT_PUBLIC_.
PIN_HASH_PEPPER=replace-with-a-long-random-server-only-secret
